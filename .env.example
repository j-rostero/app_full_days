# API
PORT=4000
DATABASE_URL=postgresql://fulldays:fulldays@localhost:5432/fulldays
REDIS_URL=redis://localhost:6379/0
# Fotos y documentos: 's3' (MinIO en local; los buckets se crean al arrancar en desarrollo) o 'memory' (solo pruebas).
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=  (dirección que usan navegadores y apps para subir, si difiere de S3_ENDPOINT)
S3_REGION=us-east-1
S3_ACCESS_KEY=fulldays
S3_SECRET_KEY=fulldays-secret
S3_BUCKET_IMAGES=fulldays-imagenes
S3_BUCKET_DOCUMENTS=fulldays-documentos
IMGPROXY_URL=http://localhost:8080
# Claves hex de imgproxy; las de desarrollo no se aceptan en producción.
IMGPROXY_KEY=736563726574
IMGPROXY_SALT=68656C6C6F
SMTP_URL=smtp://localhost:1025
# Códigos de acceso: 'log' los escribe en la consola de la API; 'smtp' los envía (Mailpit en local: http://localhost:8025).
OTP_SENDER=log
# JWT_SECRET=  (obligatorio en producción, 32 caracteres o más)
# GOOGLE_CLIENT_IDS=  (ids de cliente OAuth de la web, Android e iOS, separados por comas)
# Vouchers: semilla Ed25519 en hex (64 caracteres); la de desarrollo no se acepta en producción.
# Genera una con: openssl rand -hex 32
# VOUCHER_SIGNING_KEY=
# Llaves públicas retiradas que la app sigue aceptando al validar vouchers viejos, separadas por comas.
# VOUCHER_RETIRED_PUBLIC_KEYS=
# Dónde queda el dinero: 'direct' (el viajero paga a la agencia) o 'retained' (la plataforma cobra y liquida).
MONEY_MODEL=direct
# Avisos a personas por correo: 'log' los escribe en la consola del worker; 'smtp' los envía (obligatorio en producción).
NOTIFICATION_EMAIL=log
# Push: cuenta de servicio de Firebase (JSON en una línea o en base64). Sin ella los avisos quedan en la bandeja.
# FCM_SERVICE_ACCOUNT=
# Cada cuántos segundos corre el mantenimiento del worker (apartados, saldos, recordatorios, salidas, archivos).
JOBS_EVERY_SECONDS=60
CORS_ORIGINS=http://localhost:3100,http://localhost:3101,http://localhost:3102

# Compartida por la API y las webs: con ella las webs informan la IP de cada persona al límite de peticiones.
WEB_SERVER_KEY=desarrollo-clave-web-servidor-0123456789

# Webs (servidor Next)
API_URL=http://localhost:4000
# Dirección pública de la web de viajeros (sitemap, enlaces canónicos y datos estructurados).
SITE_URL=http://localhost:3100
