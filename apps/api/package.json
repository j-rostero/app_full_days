{
  "name": "@fulldays/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch-path=dist --env-file-if-exists=../../.env dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.json --outDir dist-test && node --test \"dist-test/**/*.spec.js\"",
    "grant-super": "node --env-file-if-exists=../../.env dist/cli/grant-super.js",
    "seed-catalogs": "node --env-file-if-exists=../../.env dist/cli/seed-catalogs.js",
    "worker": "node dist/worker.js",
    "dev:worker": "node --watch-path=dist --env-file-if-exists=../../.env dist/worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@fulldays/db": "workspace:*",
    "@fulldays/shared": "workspace:*",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "bullmq": "^5.81.5",
    "ioredis": "^5.11.1",
    "jose": "^6.2.15",
    "nodemailer": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fulldays/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2"
  }
}
