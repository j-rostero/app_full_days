# Variables de producción para docker-compose.prod.yml. Copia a `produccion.env` en la raíz
# (está en .gitignore) y reemplaza cada valor. La API se niega a arrancar con los de desarrollo.

NODE_ENV=production

# Base y Redis. Con los servicios del compose:
POSTGRES_USER=fulldays
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=fulldays
DATABASE_URL=postgresql://fulldays:cambia-esta-clave@postgres:5432/fulldays
REDIS_URL=redis://redis:6379/0

# Secretos: genera cada uno con `openssl rand -hex 32`.
JWT_SECRET=
VOUCHER_SIGNING_KEY=
WEB_SERVER_KEY=
IMGPROXY_KEY=
IMGPROXY_SALT=

# Detrás de un proxy (Caddy, Nginx o el balanceador): cuántos saltos confiar.
TRUST_PROXY=1
CORS_ORIGINS=https://fulldays.com.ve,https://pro.fulldays.com.ve,https://central.fulldays.com.ve
SITE_URL=https://fulldays.com.ve

# Almacenamiento S3 (AWS, Cloudflare R2, Backblaze…) e imgproxy.
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_IMAGES=fulldays-imagenes
S3_BUCKET_DOCUMENTS=fulldays-documentos
IMGPROXY_URL=https://img.fulldays.com.ve

# Correo: códigos de acceso y avisos.
SMTP_URL=smtps://usuario:clave@smtp.proveedor.com:465
MAIL_FROM=FullDays <no-responder@fulldays.com.ve>
OTP_SENDER=smtp
NOTIFICATION_EMAIL=smtp

# Push (opcional): cuenta de servicio de Firebase en base64.
# FCM_SERVICE_ACCOUNT=
# Entrar con Google (opcional): ids de cliente web, Android e iOS.
# GOOGLE_CLIENT_IDS=

MONEY_MODEL=direct
JOBS_EVERY_SECONDS=60
