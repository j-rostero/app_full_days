// Esquema único de la base de datos. Las tablas llegan con cada fase
// (cuentas en la Fase 1; ver docs/referencia/integracion.md, sección Datos).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ── Fase 1: cuentas, sesiones y permisos ──────────────────────────────────────

/// Una cuenta por correo. La misma persona puede ser viajera, de una o varias agencias y de Central.
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  name            String?
  phone           String?
  /// `scrypt$sal$clave`. Nulo si solo entra con Google o si la añadieron a un equipo y no se ha registrado.
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  googleId        String?   @unique @map("google_id")
  /// Una cuenta bloqueada no puede entrar y sus sesiones quedan revocadas.
  blockedAt       DateTime? @map("blocked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  passengers    Passenger[]
  memberships   ProviderMember[]
  staffRoles    StaffMember[]
  auditLog      AuditLog[]
  files         File[]
  guiding       DepartureGuide[]
  bookings      Booking[]
  favorites     Favorite[]
  notices       DepartureNotice[]
  reviews       Review[]
  claims        Claim[]
  claimNotes    ClaimMessage[]
  notifications Notification[]
  devices       DeviceToken[]

  @@map("users")
}

/// Una sesión por dispositivo. El token de renovación solo se guarda como SHA-256.
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  device    String    @default("")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  retired RetiredToken[]

  @@index([userId])
  @@map("sessions")
}

/// Tokens de renovación ya reemplazados. Si uno vuelve (fuera de la ventana de reintento), alguien tiene una copia.
model RetiredToken {
  tokenHash String   @id @map("token_hash")
  sessionId String   @map("session_id") @db.Uuid
  retiredAt DateTime @default(now()) @map("retired_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("retired_tokens")
}

/// Pasajero frecuente de una persona, para reservar más rápido.
model Passenger {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String
  cedula       String?
  birthDate    DateTime @map("birth_date") @db.Date
  restrictions String?
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passengers")
}

enum ProviderKind {
  person
  company

  @@map("provider_kind")
}

enum ProviderStatus {
  pending
  in_review
  approved
  rejected
  suspended

  @@map("provider_status")
}

/// Agencia u organizador. Solo una aprobada vende.
model Provider {
  id                  String         @id @default(uuid(7)) @db.Uuid
  kind                ProviderKind
  name                String
  legalName           String         @map("legal_name")
  rif                 String         @unique
  /// Registro Turístico Nacional. Con él la agencia luce el distintivo de verificada.
  rtn                 String?
  baseCity            String         @map("base_city")
  phone               String
  instagram           String?
  paymentInstructions String?        @map("payment_instructions")
  status              ProviderStatus @default(pending)
  /// Motivo del último rechazo o suspensión.
  statusReason        String?        @map("status_reason")
  /// Comisión propia (0 a 50 %); nula usa la de la plataforma.
  commissionPercent   Decimal?       @map("commission_percent") @db.Decimal(5, 2)
  submittedAt         DateTime?      @map("submitted_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  members    ProviderMember[]
  auditLog   AuditLog[]
  documents  ProviderDocument[]
  products   Product[]
  departures Departure[]
  bookings   Booking[]
  payments   Payment[]
  refund     Refund?            @relation(fields: [refundId], references: [id])
  review     Review?            @relation(fields: [reviewId], references: [id])
  claims     Claim[]
  ledger     LedgerEntry[]
  refundId   String?            @db.Uuid
  reviewId   String?            @db.Uuid

  @@index([status, submittedAt])
  @@map("providers")
}

enum ProviderDocumentType {
  rif
  representative_id
  rtn
  commercial_registry
  other

  @@map("provider_document_type")
}

/// Documento de verificación de una agencia: un archivo privado ya subido.
model ProviderDocument {
  id         String               @id @default(uuid(7)) @db.Uuid
  providerId String               @map("provider_id") @db.Uuid
  type       ProviderDocumentType
  fileId     String               @unique @map("file_id") @db.Uuid
  createdAt  DateTime             @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  file     File     @relation(fields: [fileId], references: [id])

  @@index([providerId])
  @@map("provider_documents")
}

enum FileKind {
  image
  document

  @@map("file_kind")
}

enum FileStatus {
  pending
  ready

  @@map("file_status")
}

/// Archivo subido directo al almacenamiento. Pertenece a quien lo subió hasta que otro registro lo adjunta.
model File {
  id          String     @id @default(uuid(7)) @db.Uuid
  uploaderId  String     @map("uploader_id") @db.Uuid
  kind        FileKind
  contentType String     @map("content_type")
  size        Int
  /// Clave del objeto en su depósito.
  key         String     @unique
  status      FileStatus @default(pending)
  createdAt   DateTime   @default(now()) @map("created_at")

  uploader User              @relation(fields: [uploaderId], references: [id])
  document ProviderDocument?
  payments Payment[]

  @@index([uploaderId])
  @@map("files")
}

/// Destino o sitio dentro de un destino (Los Roques → Cayo de Agua).
model Destination {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  name      String
  state     String   @default("")
  region    String   @default("")
  lat       Float?
  lng       Float?
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  parent   Destination?     @relation("DestinationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Destination[]    @relation("DestinationTree")
  fees     DestinationFee[]

  @@map("destinations")
}

/// Tasa o entrada conocida de un destino, para orientar a las agencias.
model DestinationFee {
  id            String  @id @default(uuid(7)) @db.Uuid
  destinationId String  @map("destination_id") @db.Uuid
  name          String
  amountUsd     Decimal @map("amount_usd") @db.Decimal(12, 2)
  payment       String

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@map("destination_fees")
}

/// Punto de embarque conocido (terminal, plaza, centro comercial).
model BoardingPoint {
  id        String   @id @default(uuid(7)) @db.Uuid
  city      String
  name      String
  address   String   @default("")
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([city])
  @@map("boarding_points")
}

enum ProductType {
  fullday
  tour
  excursion

  @@map("product_type")
}

enum ProductStatus {
  draft
  in_review
  published
  paused

  @@map("product_status")
}

/// Fullday, tour o excursión. La ficha es un documento validado por `ProductSheetSchema`.
model Product {
  id           String        @id @default(uuid(7)) @db.Uuid
  providerId   String        @map("provider_id") @db.Uuid
  type         ProductType
  status       ProductStatus @default(draft)
  /// Motivo con que Central lo devolvió o despublicó. Mientras no sea nulo, publicar pasa por revisión.
  statusReason String?       @map("status_reason")
  sheet        Json
  /// Control optimista: cada guardado debe traer la versión que leyó.
  version      Int           @default(1)
  featured     Boolean       @default(false)
  statusAt     DateTime      @default(now()) @map("status_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  provider   Provider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  departures Departure[]
  themes     ProductTheme[]
  favorites  Favorite[]

  @@index([providerId, id])
  @@index([status, statusAt])
  @@map("products")
}

/// Temática que navegan los viajeros (Playas, Para ir con niños, Semana Santa).
model Theme {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  products ProductTheme[]

  @@map("themes")
}

model ProductTheme {
  productId String @map("product_id") @db.Uuid
  themeId   String @map("theme_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  theme   Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([productId, themeId])
  @@map("product_themes")
}

enum DepartureStatus {
  open
  paused
  closed
  in_progress
  finished
  cancelled

  @@map("departure_status")
}

/// Una fecha en que corre un producto. Guarda la ficha con que se vende y columnas de búsqueda derivadas.
model Departure {
  id            String          @id @default(uuid(7)) @db.Uuid
  providerId    String          @map("provider_id") @db.Uuid
  productId     String          @map("product_id") @db.Uuid
  date          DateTime        @db.Date
  status        DepartureStatus @default(open)
  capacity      Int
  minCapacity   Int             @default(1) @map("min_capacity")
  /// Puestos apartados o vendidos. Una restricción CHECK impide pasar del cupo.
  reserved      Int             @default(0)
  /// Precio de adulto de esta salida; nulo usa el de la ficha.
  adultPriceUsd Decimal?        @map("adult_price_usd") @db.Decimal(12, 2)
  sheet         Json
  // Facetas de búsqueda, derivadas de la ficha al programar o al guardarla.
  productType   ProductType     @map("product_type")
  category      String?
  destinationId String?         @map("destination_id") @db.Uuid
  priceUsd      Decimal         @map("price_usd") @db.Decimal(12, 2)
  cities        String[]
  includes      String[]
  tags          String[]
  searchText    String          @default("") @map("search_text")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  provider Provider          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  guides   DepartureGuide[]
  bookings Booking[]
  quotas   DepartureQuota[]
  notices  DepartureNotice[]

  @@unique([productId, date])
  @@index([providerId, date])
  @@index([status, date])
  @@map("departures")
}

/// Guía asignado a una salida. Debe ser miembro de la agencia.
model DepartureGuide {
  departureId String @map("departure_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid

  departure Departure @relation(fields: [departureId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([departureId, userId])
  @@map("departure_guides")
}

/// Tasa bolívares por dólar de un día, cargada por Central.
model ExchangeRate {
  date      DateTime @id @db.Date
  bsPerUsd  Decimal  @map("bs_per_usd") @db.Decimal(14, 4)
  setById   String   @map("set_by_id") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("exchange_rates")
}

/// Ajustes de reserva de la plataforma. Una sola fila (`id = 1`).
model Setting {
  id        Int      @id @default(1)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

enum ProviderRole {
  owner
  operations
  finance
  guide

  @@map("provider_role")
}

/// Pertenencia de una persona a una agencia, con un rol.
model ProviderMember {
  id         String       @id @default(uuid(7)) @db.Uuid
  providerId String       @map("provider_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  role       ProviderRole
  createdAt  DateTime     @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, userId])
  @@index([userId])
  @@map("provider_members")
}

enum StaffRole {
  super
  support
  moderation
  content
  finance

  @@map("staff_role")
}

/// Un rol de Central de una persona. Puede tener varios.
model StaffMember {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      StaffRole
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("staff_members")
}

enum AuditScope {
  provider
  central

  @@map("audit_scope")
}

/// Cada escritura en /v1/pro y /v1/central, escrita en la misma transacción que la acción.
model AuditLog {
  id         String     @id @default(uuid(7)) @db.Uuid
  actorId    String     @map("actor_id") @db.Uuid
  scope      AuditScope
  providerId String?    @map("provider_id") @db.Uuid
  /// `MÉTODO /ruta/con/:parametros`
  action     String
  params     Json       @default("{}")
  input      Json?
  before     Json?
  after      Json?
  createdAt  DateTime   @default(now()) @map("created_at")

  actor    User      @relation(fields: [actorId], references: [id])
  provider Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([providerId, id])
  @@map("audit_log")
}

// ── Fase 3: búsqueda, reserva y pago ─────────────────────────────────────────

/// Cupo limitado dentro de una salida (habitaciones por tipo, porciones de un plato). Un CHECK impide pasar del límite.
model DepartureQuota {
  departureId String @map("departure_id") @db.Uuid
  /// `room:<id>` o `meal:<id>`.
  key         String
  limit       Int
  taken       Int    @default(0)

  departure Departure @relation(fields: [departureId], references: [id], onDelete: Cascade)

  @@id([departureId, key])
  @@map("departure_quotas")
}

enum BookingStatus {
  held
  in_review
  deposit_paid
  paid
  expired
  cancelled
  completed
  no_show

  @@map("booking_status")
}

enum BookingSource {
  app
  agency

  @@map("booking_source")
}

/// Una reserva de una salida. Las de la app tienen `userId`; las ventas propias de la agencia, contacto.
model Booking {
  id             String        @id @default(uuid(7)) @db.Uuid
  code           String        @unique
  providerId     String        @map("provider_id") @db.Uuid
  departureId    String        @map("departure_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  source         BookingSource @default(app)
  status         BookingStatus @default(held)
  /// Selección validada: embarque, pasajeros por tipo, habitaciones, comidas y extras.
  selection      Json
  lines          Json
  seats          Int
  totalUsd       Decimal       @map("total_usd") @db.Decimal(12, 2)
  depositUsd     Decimal       @map("deposit_usd") @db.Decimal(12, 2)
  paidUsd        Decimal       @default(0) @map("paid_usd") @db.Decimal(12, 2)
  balanceDueDate DateTime      @map("balance_due_date") @db.Date
  /// Hasta cuándo se guardan los puestos mientras está `held`.
  heldUntil      DateTime?     @map("held_until")
  contactName    String?       @map("contact_name")
  contactPhone   String?       @map("contact_phone")
  contactEmail   String?       @map("contact_email")
  cancelledAt    DateTime?     @map("cancelled_at")
  /// Quién canceló: `traveler`, `agency` o `system` (salida cancelada o saldo vencido).
  cancelledBy    String?       @map("cancelled_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  provider   Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  departure  Departure          @relation(fields: [departureId], references: [id], onDelete: Cascade)
  user       User?              @relation(fields: [userId], references: [id])
  passengers BookingPassenger[]
  payments   Payment[]
  refund     Refund?
  review     Review?
  claims     Claim[]

  @@index([providerId, departureId])
  @@index([userId, createdAt])
  @@index([status, heldUntil])
  @@map("bookings")
}

enum PassengerType {
  adult
  child
  senior
  infant

  @@map("passenger_type")
}

enum Checkin {
  boarded
  no_show

  @@map("checkin")
}

model BookingPassenger {
  id           String        @id @default(uuid(7)) @db.Uuid
  bookingId    String        @map("booking_id") @db.Uuid
  position     Int
  type         PassengerType
  name         String?
  cedula       String?
  birthDate    DateTime?     @map("birth_date") @db.Date
  restrictions String?
  /// Platos escogidos: id de la comida → ids de las opciones.
  mealPicks    Json          @default("{}") @map("meal_picks")
  checkin      Checkin?
  /// Hora del teléfono de la última marca; gana la más reciente.
  checkinAt    DateTime?     @map("checkin_at")
  checkinById  String?       @map("checkin_by_id") @db.Uuid

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, position])
  @@map("booking_passengers")
}

enum PaymentMethod {
  mobile_payment
  bank_transfer
  zelle
  cash_usd

  @@map("payment_method")
}

enum PaymentStatus {
  pending
  confirmed
  rejected

  @@map("payment_status")
}

/// Un pago hecho fuera de la plataforma, reportado por el viajero o registrado por la agencia.
model Payment {
  id             String        @id @default(uuid(7)) @db.Uuid
  providerId     String        @map("provider_id") @db.Uuid
  bookingId      String        @map("booking_id") @db.Uuid
  method         PaymentMethod
  /// Normalizada (sin espacios ni guiones, mayúsculas); única para no contar dos veces el mismo pago.
  reference      String        @unique
  amountUsd      Decimal       @map("amount_usd") @db.Decimal(12, 2)
  /// Tasa y monto en bolívares de los métodos en bolívares.
  bsPerUsd       Decimal?      @map("bs_per_usd") @db.Decimal(14, 4)
  amountBs       Decimal?      @map("amount_bs") @db.Decimal(16, 2)
  proofFileId    String?       @map("proof_file_id") @db.Uuid
  status         PaymentStatus @default(pending)
  reason         String?
  idempotencyKey String        @map("idempotency_key")
  reportedById   String?       @map("reported_by_id") @db.Uuid
  reviewedById   String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?     @map("reviewed_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  proof    File?    @relation(fields: [proofFileId], references: [id])

  @@unique([bookingId, idempotencyKey])
  @@index([providerId, status, createdAt])
  @@map("payments")
}

/// Libro de partida doble: cada pago confirmado deja asientos que cuadran por `transactionId`.
model LedgerEntry {
  id            String   @id @default(uuid(7)) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  providerId    String   @map("provider_id") @db.Uuid
  bookingId     String?  @map("booking_id") @db.Uuid
  paymentId     String?  @map("payment_id") @db.Uuid
  refundId      String?  @map("refund_id") @db.Uuid
  account       String
  debitUsd      Decimal  @default(0) @map("debit_usd") @db.Decimal(12, 2)
  creditUsd     Decimal  @default(0) @map("credit_usd") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("favorites")
}

/// Primera página de cada búsqueda, para las métricas de Central.
model SearchLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  text      String?
  filters   Json
  results   Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("search_log")
}

/// Aviso de la agencia a los viajeros de una salida (cambio de hora, punto de encuentro, clima).
model DepartureNotice {
  id          String   @id @default(uuid(7)) @db.Uuid
  providerId  String   @map("provider_id") @db.Uuid
  departureId String   @map("departure_id") @db.Uuid
  authorId    String   @map("author_id") @db.Uuid
  body        String
  createdAt   DateTime @default(now()) @map("created_at")

  departure Departure @relation(fields: [departureId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])

  @@index([departureId, createdAt])
  @@map("departure_notices")
}

enum RefundStatus {
  pending
  paid

  @@map("refund_status")
}

/// Dinero que la agencia debe devolver al cancelar. Se asienta en el libro al pagarlo.
model Refund {
  id         String       @id @default(uuid(7)) @db.Uuid
  providerId String       @map("provider_id") @db.Uuid
  bookingId  String       @unique @map("booking_id") @db.Uuid
  amountUsd  Decimal      @map("amount_usd") @db.Decimal(12, 2)
  rule       String
  status     RefundStatus @default(pending)
  reference  String?
  paidById   String?      @map("paid_by_id") @db.Uuid
  paidAt     DateTime?    @map("paid_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  booking   Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  providers Provider[]

  @@index([providerId, status])
  @@map("refunds")
}

enum ReviewStatus {
  visible
  hidden

  @@map("review_status")
}

/// Reseña de una reserva realizada; una por reserva.
model Review {
  id           String       @id @default(uuid(7)) @db.Uuid
  providerId   String       @map("provider_id") @db.Uuid
  productId    String       @map("product_id") @db.Uuid
  bookingId    String       @unique @map("booking_id") @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  rating       Int
  /// Notas por aspecto (1 a 5): puntualidad, transporte, comida, guía, precio-calidad.
  aspects      Json         @default("{}")
  asDescribed  Boolean      @map("as_described")
  comment      String       @default("")
  status       ReviewStatus @default(visible)
  reported     Boolean      @default(false)
  reportReason String?      @map("report_reason")
  hiddenReason String?      @map("hidden_reason")
  reply        String?
  repliedAt    DateTime?    @map("replied_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  booking   Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  providers Provider[]

  @@index([providerId, status])
  @@index([productId, status])
  @@map("reviews")
}

enum ClaimStatus {
  open
  escalated
  resolved

  @@map("claim_status")
}

model Claim {
  id         String      @id @default(uuid(7)) @db.Uuid
  providerId String      @map("provider_id") @db.Uuid
  bookingId  String      @map("booking_id") @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  subject    String
  status     ClaimStatus @default(open)
  resolution String?
  resolvedAt DateTime?   @map("resolved_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  booking  Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ClaimMessage[]
  provider Provider       @relation(fields: [providerId], references: [id])

  @@index([providerId, status])
  @@index([status, updatedAt])
  @@map("claims")
}

model ClaimMessage {
  id        String   @id @default(uuid(7)) @db.Uuid
  claimId   String   @map("claim_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  /// `traveler`, `agency` o `central`.
  role      String
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  claim  Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([claimId, createdAt])
  @@map("claim_messages")
}

enum NotificationChannel {
  push
  email

  @@map("notification_channel")
}

enum NotificationStatus {
  pending
  sent
  failed
  skipped

  @@map("notification_status")
}

/// Un mensaje para una persona por un canal. La bandeja de la app lee las filas `push`.
model Notification {
  id            String              @id @default(uuid(7)) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  event         String
  title         String
  body          String
  /// Adónde lleva al tocarla, por ejemplo `reserva:<id>`.
  link          String?
  channel       NotificationChannel
  status        NotificationStatus  @default(pending)
  attempts      Int                 @default(0)
  /// Antes de esta hora nadie la toma: reserva el envío en curso y espacia los reintentos.
  nextAttemptAt DateTime            @default(now()) @map("next_attempt_at")
  error         String?
  /// Evita encolar dos veces el mismo mensaje (por ejemplo un recordatorio por reserva).
  dedupeKey     String?             @map("dedupe_key")
  readAt        DateTime?           @map("read_at")
  sentAt        DateTime?           @map("sent_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey, channel])
  @@index([status, nextAttemptAt])
  @@index([userId, channel, createdAt])
  @@map("notifications")
}

/// Token de Firebase Cloud Messaging de un teléfono.
model DeviceToken {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}
